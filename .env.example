# GitHub Webhook Secret
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=<some-secret>

# Webhook container behavior
INIT_SERVICES=true
BUILD_ON_INIT=false
#
## Swarm-mode only: private registry address other nodes pull from (see SWARM_SETUP.md)
#REGISTRY=localhost:5000
#
## Email notifications for webhook rebuilds (optional — leave blank to disable)
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=
#SMTP_STARTTLS=on
#NOTIFY_EMAIL=
#
## oxidize-books default admin user
#DEFAULT_USER_EMAIL=
#DEFAULT_USER_USERNAME=
#DEFAULT_USER_PASSWORD=

# civilization (Advanced Civilization game server) — see
# repos/civilization/civilization-deploy.md for the full deploy plan.
# CIV_SEATS/CIV_NUM_PLAYERS default to 0/5 (pure AI self-play) if unset.
# CIV_NETCODE_KEY defaults to "random" if unset, which is fine for testing
# but invalidates reconnect tokens across container restarts — generate a
# real one for a long-running public game with: openssl rand -hex 32
CIV_SEATS=0
CIV_NUM_PLAYERS=5
CIV_NETCODE_KEY=<64-hex-char-secret-or-leave-unset-for-random>
