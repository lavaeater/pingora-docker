{
    "listen_addr": "0.0.0.0:8080",
    "tls_listen_addr": "0.0.0.0:8443",
    "tls": {
        "cert_path": "/certs/cert.pem",
        "key_path": "/certs/key.pem",
        "enable_h2": true
    },
    "auth": {
        "login_url": "https://login.snakeface.asuscomm.com/login",
        "cookie_name": "session",
        "issuer": "https://login.snakeface.asuscomm.com",
        "audience": "home",
        "public_key_path": "/certs/auth-public.pem"
    },
    "domains": {
        "rusty.snakeface.asuscomm.com": {
            "host": "rusty-budgets",
            "port": 8666,
            "tls": false,
            "auth": "required",
            "allow": ["group:family"]
        },
        "jelly.snakeface.asuscomm.com": {
            "host": "jellyfin",
            "port": 8096,
            "tls": false
        },
        "sickgear.snakeface.asuscomm.com": {
            "host": "sickgear",
            "port": 8081,
            "tls": false
        }
    }
}
