# systemd user unit for one GitHub Actions runner. Installed and enabled by
# ci/add-runner.sh as gh-runner@<owner>.<repo>.service — do not edit the copy
# in ~/.config/systemd/user, re-run add-runner.sh instead.
[Unit]
Description=GitHub Actions runner (%i)
After=network-online.target

[Service]
WorkingDirectory=%h/actions-runners/%i
EnvironmentFile=%h/actions-runners/%i/service.env
ExecStart=%h/actions-runners/%i/run.sh
Restart=always
RestartSec=10
# Builds are background work: stay out of the way of the desktop.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
